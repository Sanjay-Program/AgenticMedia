# Database
DATABASE_URL=postgresql://agenticmedia:localdev@localhost:5432/agenticmedia

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-secure-random-string
JWT_REFRESH_SECRET=replace-with-another-secure-random-string
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=replace-with-64-char-hex-string

# Stripe
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PLATFORM_FEE_PERCENT=2

# B2B Scraping APIs
APOLLO_API_KEY=replace
ZOOMINFO_API_KEY=replace

# LLM
OPENAI_API_KEY=replace
ANTHROPIC_API_KEY=replace

# Email (SendGrid/SES)
EMAIL_API_KEY=replace
EMAIL_FROM=deals@agenticmedia.com

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
